# Health360 AI — Local Development Environment
# Copy to .env and adjust as needed. Never commit .env with secrets.

# PostgreSQL
POSTGRES_DB=health360_db
POSTGRES_USER=health360
POSTGRES_PASSWORD=health360_local_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend API
API_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Frontend
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Keep-alive (production): pings API every 5 min while web app is open — requires absolute API URL above
# VITE_KEEP_ALIVE_ENABLED=true
# VITE_KEEP_ALIVE_INTERVAL_MS=300000
# VITE_KEEP_ALIVE_URL=https://your-api.onrender.com/api/v1/health/awake
# Optional: enables interactive Google Maps on public hospital profiles
# VITE_GOOGLE_MAPS_API_KEY=

# Production (Render): frontend origin used for email links AND CORS allowed origins
# APP_BASE_URL=https://hms.techearnest.com
# CORS_ALLOWED_ORIGINS=

# Default tenant (single-tenant MVP)
DEFAULT_TENANT_SLUG=default

# JWT (generate RS256 keys for non-local; local profile uses embedded dev keys)
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Razorpay (Phase F) — leave blank for now; sandbox mock pay works without keys.
# Fill in when you have a Razorpay dashboard account (test keys first).
RAZORPAY_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional override (default is Razorpay production API host; test keys still use this host)
# RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# SMS gateway (Phase G1) — default log stub; set SMS_PROVIDER=msg91 + SMS_AUTH_KEY when ready
SMS_ENABLED=true
SMS_PROVIDER=log
SMS_AUTH_KEY=
SMS_SENDER_ID=H360AI
SMS_TEMPLATE_ID=
# SMS_API_BASE_URL=https://control.msg91.com/api/v5
# SMS_SEND_HTTP_URL=https://api.msg91.com/api/sendhttp.php
# To use MSG91: SMS_PROVIDER=msg91 and set SMS_AUTH_KEY (+ SMS_TEMPLATE_ID for DLT Flow API)
