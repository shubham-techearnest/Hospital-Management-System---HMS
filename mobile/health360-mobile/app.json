{
  "expo": {
    "name": "Health360 AI",
    "slug": "health360-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "health360",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#714fff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.health360.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#714fff"
      },
      "package": "com.health360.mobile"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:8080/api/v1"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Health360 uses your location to find nearby doctors and hospitals."
        }
      ]
    ]
  }
}
